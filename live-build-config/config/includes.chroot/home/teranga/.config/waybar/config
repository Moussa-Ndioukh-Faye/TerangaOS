{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 3,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "network", "battery", "tray"],

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "urgent": "⚠"
        }
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 50
    },

    "clock": {
        "format": "<span color='#FFBE00'>%H:%M</span>",
        "format-alt": "<span color='#FFBE00'>%A %d %B</span>",
        "tooltip-format": "<big>{:H:%M}</big><br><i>{}</i>"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-bluetooth": "{icon}",
        "format-bluetooth-muted": "🔇",
        "format-icons": {
            "headphone": "🎧",
            "hands-free": "🎤",
            "headset": "🎧",
            "phone": "📱",
            "portable": "📱",
            "default": ["🔈", "🔉", "🔊"]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "📶 {signalStrength}%",
        "format-ethernet": "🌐 {ipaddr}",
        "tooltip-format": "WiFi: {ssid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
        "format-linked": "🌐 {ifname}",
        "format-disconnected": "⚠ Disconnected",
        "interval": 5
    },

    "battery": {
        "states": {
            "good": 100,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "⚡ {capacity}%",
        "format-alt": "{icon}",
        "format-icons": ["🪫", "🔋", "🔋", "🔋", "🔋"]
    },

    "tray": {
        "spacing": 10
    },

    "tooltip": {
        "show": true
    }
}