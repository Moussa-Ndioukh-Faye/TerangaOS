#!/bin/bash
# =============================================================================
# TérangaOS - Hook Configuration Bootloader
# Codename: Djolof | Version: 1.0
# =============================================================================

set -e

echo "[TERANGOS] Configuration Bootloader..."

# =============================================================================
# GRUB Configuration
# =============================================================================
if command -v update-grub &>/dev/null; then
    echo "[TERANGOS] Configuration GRUB..."
    
    # Create GRUB config
    cat > /etc/default/grub << 'EOF'
# GRUB Default Configuration for TérangaOS
GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu
GRUB_DISTRIBUTOR="TérangaOS"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_GFXMODE=1920x1080
GRUB_GFXPAYLOAD_LINUX=keep
EOF

    # Update GRUB
    update-grub 2>/dev/null || true
fi

# =============================================================================
# syslinux (backup bootloader)
# =============================================================================
if [ -d /boot/syslinux ]; then
    echo "[TERANGOS] Configuration syslinux..."
    
    cat > /boot/syslinux/syslinux.cfg << 'EOF'
UI vesamenu.c32
MENU TITLE TérangaOS 1.0 Djolof
MENU BACKGROUND terangaos.png

LABEL terangaos
    MENU LABEL TérangaOS 1.0 (Djolof)
    LINUX /live/vmlinuz
    INITRD /live/initrd.img
    APPEND boot=live components locales=fr_FR.UTF-8 keyboard-layouts=fr

LABEL live
    MENU LABEL TérangaOS (Live)
    LINUX /live/vmlinuz
    INITRD /live/initrd.img
    APPEND boot=live components

LABEL memtest
    MENU LABEL Memtest86+
    LINUX /memtest86+/memtest
EOF
fi

# =============================================================================
# Plymouth (boot splash)
# =============================================================================
if command -v plymouth &>/dev/null; then
    echo "[TERANGOS] Configuration Plymouth..."
    systemctl enable plymouth 2>/dev/null || true
fi

echo "[TERANGOS] Bootloader configuré"