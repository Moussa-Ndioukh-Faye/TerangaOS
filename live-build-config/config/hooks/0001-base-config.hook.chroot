#!/bin/bash
# =============================================================================
# TérangaOS - Hook Configuration de Base
# Codename: Djolof | Version: 1.0
# =============================================================================

set -e

echo "[TERANGOS] Configuration de base..."

# =============================================================================
# Locale
# =============================================================================
echo "[TERANGOS] Configuration locale..."
sed -i 's/# fr_FR.UTF-8 UTF-8/fr_FR.UTF-8 UTF-8/' /etc/locale.gen
locale-gen

# =============================================================================
# Timezone
# =============================================================================
echo "[TERANGOS] Configuration timezone..."
ln -sf /usr/share/zoneinfo/Africa/Dakar /etc/localtime
hwclock --systohc

# =============================================================================
# Console font
# =============================================================================
echo "[TERANGOS] Configuration console..."
setfont latarcyrheb-sun16

# =============================================================================
#hostname
# =============================================================================
echo "terangaos" > /etc/hostname

# =============================================================================
# hosts
# =============================================================================
cat > /etc/hosts << 'EOF'
127.0.0.1       localhost
127.0.1.1       terangaos

# The following lines are desirable for IPv6 capable hosts
::1     ip6-localhost ip6-loopback
fe00::0 ip6-localhost
ff00::0 ip6-localhost
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
EOF

# =============================================================================
# motd
# =============================================================================
cat > /etc/motd << 'EOF'
╔══════════════════════════════════════════════════════════════╗
║                                                              ║
║   ████████╗███████╗██████╗  █████╗ ███╗  ██╗ ██████╗  █████╗ ║
║   ╚══██╔══╝██╔════╝██╔══██╗██╔══██╗████╗ ██║██╔════╝ ██╔══██╗║
║      ██║   █████╗  ██████╔╝███████║██╔██╗██║██║ ████╗███████║║
║      ██║   ██╔══╝  ██╔══██╗██╔══██║██║╚████║██║   ██║██╔══██║║
║      ██║   ███████╗██║  ██║██║  ██║██║ ╚███║╚██████╔╝██║  ██║║
║      ╚═╝   ╚══════╝╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚══╝ ╚═════╝ ╚═╝  ╚═╝║
║                                                              ║
║              TérangaOS 1.0 — Codename: Djolof            ║
║         L'hospitalité numérique africaine                     ║
║                                                              ║
╚═══════════════════════════════════════════════���══════════════╝

 Bienvenue sur TérangaOS!
 Supports: GitHub - ESP/UCAD Dakar

 Documentation: https://terangaos.djekas.net
EOF

# =============================================================================
# Bashrc root
# =============================================================================
cat > /root/.bashrc << 'EOF'
# TérangaOS prompt
PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
alias ls='ls --color=auto'
alias grep='grep --color=auto'
EOF

echo "[TERANGOS] Configuration de base terminée"