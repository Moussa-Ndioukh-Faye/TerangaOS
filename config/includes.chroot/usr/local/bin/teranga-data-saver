#!/bin/bash
# TérangaOS — mode économie de données
# Marque la connexion active comme « limitée » (metered) : GNOME Logiciels
# et les mises à jour automatiques arrêtent alors de télécharger en fond.

active_connection() {
    nmcli -t -f NAME,DEVICE connection show --active | awk -F: '$2 != "lo" {print $1; exit}'
}

status() {
    local con
    con=$(active_connection)
    if [ -n "$con" ] && [ "$(nmcli -g connection.metered connection show "$con")" = "yes" ]; then
        echo "📡 ÉCO"
    else
        echo "🌐 NORMAL"
    fi
}

toggle() {
    local con
    con=$(active_connection)
    if [ -z "$con" ]; then
        notify-send -i network-offline "TérangaOS" "Aucune connexion active"
        return 1
    fi
    if [ "$(nmcli -g connection.metered connection show "$con")" = "yes" ]; then
        nmcli connection modify "$con" connection.metered no
        notify-send -i network-transmit-receive "TérangaOS" "Économie de données DÉSACTIVÉE ($con)"
    else
        nmcli connection modify "$con" connection.metered yes
        pkill -f "ollama serve" 2>/dev/null || true
        notify-send -i network-cellular-signal-weak "TérangaOS" "Économie de données ACTIVÉE ($con)"
    fi
}

case "${1:-toggle}" in
    toggle) toggle ;;
    status) status ;;
    *) echo "Usage : $0 {toggle|status}" ;;
esac
