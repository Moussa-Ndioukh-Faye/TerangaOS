#!/bin/bash
# TérangaOS — thème dynamique Djolof (jour) / Harmattan (nuit) pour GNOME
# Lancé à l'ouverture de session (/etc/xdg/autostart/teranga-theme-engine.desktop)

HEURE=$(date +%-H)

if [ "$HEURE" -ge 6 ] && [ "$HEURE" -lt 18 ]; then
    gsettings set org.gnome.desktop.interface color-scheme 'default'
    gsettings set org.gnome.desktop.interface accent-color 'yellow' 2>/dev/null || true
    MODE="Djolof (jour)"
else
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
    gsettings set org.gnome.desktop.interface accent-color 'orange' 2>/dev/null || true
    MODE="Harmattan (nuit)"
fi

FERIE=$(teranga-calendar)
if [ "$FERIE" != "Dakar, Sénégal" ]; then
    notify-send -i calendar "TérangaOS" "$FERIE"
fi

[ "${1:-}" = "--quiet" ] || notify-send -i preferences-desktop-theme "TérangaOS" "Mode $MODE activé"
