// TérangaOS — Waybar Configuration
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,

  "modules-left": [
    "custom/logo",
    "custom/senegal",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "custom/calendar",
    "clock"
  ],

  "modules-right": [
    "custom/datasaver",
    "custom/ollama",
    "custom/separator",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "temperature",
    "battery",
    "custom/separator",
    "tray",
    "custom/power"
  ],

  // ── GAUCHE ──
  "custom/logo": {
    "format": "🌍 TérangaOS",
    "tooltip": false,
    "on-click": "wofi --show drun --prompt 'TérangaOS'"
  },

  "custom/senegal": {
    "format": "🇸🇳 Sénégal",
    "tooltip": "Accès aux services locaux",
    "on-click": "teranga-services"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "sort-by-number": true,
    "persistent-workspaces": {
      "1": [], "2": [], "3": [], "4": [], "5": []
    }
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 40,
    "separate-outputs": true
  },

  // ── CENTRE ──
  "custom/calendar": {
    "exec": "teranga-calendar",
    "interval": 3600,
    "format": "{}",
    "tooltip": false
  },

  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%A %d %B %Y · %H:%M:%S}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "interval": 1
  },

  // ── DROITE ──
  "custom/datasaver": {
    "exec": "teranga-data-saver status",
    "interval": 2,
    "on-click": "teranga-data-saver toggle",
    "format": "{}",
    "tooltip": "Cliquer pour basculer le mode Économie de Données"
  },

  "custom/ollama": {
    "exec": "systemctl is-active --quiet ollama && echo '🤖 AI ●' || echo '🤖 AI ○'",
    "interval": 10,
    "on-click": "kitty ollama run llama3.1",
    "tooltip": true,
    "tooltip-format": "Cliquer pour lancer TérangaAI (Llama 3.1)"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "🔇 Muet",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "tooltip-format": "{desc} — {volume}%"
  },

  "network": {
    "format-wifi": "  {essid} ({signalStrength}%)",
    "format-ethernet": "  Ethernet",
    "format-disconnected": "⚠ Déconnecté",
    "format-linked": "  {ifname} (sans IP)",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor",
    "interval": 5
  },

  "cpu": {
    "format": " {usage}%",
    "tooltip": true,
    "interval": 2,
    "on-click": "kitty btop"
  },

  "memory": {
    "format": " {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "on-click": "kitty btop"
  },

  "temperature": {
    "critical-threshold": 80,
    "format": " {temperatureC}°C",
    "format-critical": " {temperatureC}°C",
    "tooltip": false
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo} — {power:.2f}W"
  },

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "tray": {
    "spacing": 8,
    "icon-size": 16
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "wlogout"
  }
}
