#!/bin/bash
# =============================================================================
# TérangaOS - Hook Branding & Wallpaper
# Codename: Djolof | Version: 1.0
# =============================================================================

set -e

echo "[TERANGOS] Configuration branding..."

# =============================================================================
# Copy wallpaper
# =============================================================================
if [ -f /usr/share/backgrounds/terangaos/teranga-wallpaper.png ]; then
    echo "[TERANGOS] Wallpaper trouvé"
else
    echo "[TERANGOS] ATTENTION: Wallpaper manquant!"
fi

# =============================================================================
# Copy GRUB theme
# =============================================================================
if [ -d /usr/share/grub/themes/terangaos ]; then
    echo "[TERANGOS] GRUB theme trouvé"
else
    echo "[TERANGOS] ATTENTION: GRUB theme manquant!"
fi

# =============================================================================
# Icons (optional)
# =============================================================================
mkdir -p /usr/share/icons/terangaos
mkdir -p /usr/share/applications/terangaos

echo "[TERANGOS] Branding configuré"