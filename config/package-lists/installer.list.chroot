# Installateur graphique Calamares
calamares calamares-settings-debian
# Outils disques et systèmes de fichiers
parted dosfstools ntfs-3g btrfs-progs xfsprogs cryptsetup
# Chargeurs d'amorçage : uniquement les variantes "-bin", qui peuvent
# coexister (grub-pc et grub-efi-amd64 sont en conflit entre eux)
grub-pc-bin grub-efi-amd64-bin grub-efi-amd64-signed shim-signed efibootmgr
